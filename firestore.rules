rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Storefront, Admin (custom auth admin@donamara.com.br), Customers (CPF/CNPJ auth), and Motoboys
    // share real-time state across devices via dm_* collections and tenants/*
    match /dm_store_info/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 120;
      allow delete: if isValidId(docId);
    }

    match /dm_categories/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 30;
      allow delete: if isValidId(docId);
    }

    match /dm_products/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 40;
      allow delete: if isValidId(docId);
    }

    match /dm_orders/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 60;
      allow delete: if isValidId(docId);
    }

    match /dm_customers/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 40;
      allow delete: if isValidId(docId);
    }

    match /dm_addresses/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 25;
      allow delete: if isValidId(docId);
    }

    match /dm_users/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 20;
      allow delete: if isValidId(docId);
    }

    match /dm_drivers/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 30;
      allow delete: if isValidId(docId);
    }

    match /dm_delivery_zones/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 25;
      allow delete: if isValidId(docId);
    }

    match /dm_tables/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 25;
      allow delete: if isValidId(docId);
    }

    match /dm_tv_media/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 25;
      allow delete: if isValidId(docId);
    }

    match /dm_totem_backups/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 25;
      allow delete: if isValidId(docId);
    }

    match /dm_sms_reminders/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 30;
      allow delete: if isValidId(docId);
    }

    match /dm_app_installs/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data.keys().size() <= 20;
      allow delete: if isValidId(docId);
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
